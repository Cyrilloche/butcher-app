POSTGRES_DB=butcher
POSTGRES_USER=butcher
POSTGRES_PASSWORD=butcher

PGADMIN_DEFAULT_EMAIL=admin@saloir.dev
PGADMIN_DEFAULT_PASSWORD=admin

ConnectionStrings__Default="Host=localhost;Port=5432;Database=butcher;Username=butcher;Password=butcher"

Jwt__SigningKey=dev-signing-key-change-me-please-at-least-32-chars
Jwt__Issuer=butcher-api-dev
Jwt__Audience=butcher-app-dev
Jwt__AccessTokenLifetimeMinutes=15
Jwt__RefreshTokenLifetimeDays=30

Cors__AllowedOrigin=http://localhost:5173

Seed__AdminEmail=admin@saloir.local
# Compte seedé = administrateur : 32 caractères minimum, majuscule, minuscule, chiffre et
# caractère spécial (IdentityPolicy, ADR-011).
Seed__AdminPassword=Change-Me4-Before-First-Local-Run

# Assistant vocal (ADR-012, specs/006-assistant-vocal) : clé La Plateforme de Mistral. Vide :
# l'assistant répond « indisponible ». Réglages facultatifs, valeur par défaut du code si absents :
# Assistant__ChatModel (ministral-14b-2512), Assistant__SpeechVoice (fr_marie_neutral),
# Assistant__MaxRequestsPerHour (30).
MISTRAL_API_KEY=
