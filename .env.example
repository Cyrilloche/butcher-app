# Copié en .env (jamais commité) et rempli avec de vraies valeurs pour la prod.

POSTGRES_DB=butcher
POSTGRES_USER=butcher
POSTGRES_PASSWORD=change-me

# URL publique de l'application (celle donnée par le tunnel Cloudflare), utilisée
# pour la policy CORS — les requêtes du frontend étant same-origin via Caddy,
# elle ne sert qu'en filet de sécurité.
PUBLIC_URL=https://saloir.example.com

JWT_SIGNING_KEY=change-me-at-least-32-characters-random
JWT_ISSUER=butcher-api
JWT_AUDIENCE=butcher-app
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# Compte partagé unique, créé automatiquement au premier démarrage si aucun
# app_user n'existe encore.
SEED_ADMIN_EMAIL=admin@saloir.local
SEED_ADMIN_PASSWORD=change-me

# Token du tunnel Cloudflare (Zero Trust > Networks > Tunnels > ton tunnel > Configure).
CF_TUNNEL_TOKEN=change-me

# Utilisées uniquement par docker-compose.prod.yml (déploiement via la CI GitHub
# Actions, images versionnées poussées sur Docker Hub par les workflows
# release-backend / release-frontend). Pas nécessaires pour builder en local
# avec docker-compose.yml.
DOCKERHUB_USERNAME=change-me
BACKEND_VERSION=0.0.0
FRONTEND_VERSION=0.0.0
